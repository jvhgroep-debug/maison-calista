{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "cream", "color": "#F7F2EA", "name": "Cream" },
				{ "slug": "cream-deep", "color": "#EFE6D8", "name": "Deep Cream" },
				{ "slug": "sand", "color": "#D9C8B0", "name": "Sand" },
				{ "slug": "sand-soft", "color": "#E8DDD0", "name": "Soft Sand" },
				{ "slug": "gold", "color": "#A67C52", "name": "Gold" },
				{ "slug": "gold-deep", "color": "#8B6540", "name": "Deep Gold" },
				{ "slug": "bronze", "color": "#6B4F3A", "name": "Bronze" },
				{ "slug": "charcoal", "color": "#2C2A28", "name": "Charcoal" },
				{ "slug": "stone", "color": "#5C574F", "name": "Stone" },
				{ "slug": "muted", "color": "#8A847A", "name": "Muted" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "ink", "color": "#1A1816", "name": "Ink" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["%", "px", "em", "rem", "vh", "vw"],
			"spacingSizes": [
				{ "slug": "2xs", "size": "0.5rem", "name": "2XS" },
				{ "slug": "xs", "size": "0.75rem", "name": "XS" },
				{ "slug": "sm", "size": "1rem", "name": "SM" },
				{ "slug": "md", "size": "1.5rem", "name": "MD" },
				{ "slug": "lg", "size": "2.5rem", "name": "LG" },
				{ "slug": "xl", "size": "4rem", "name": "XL" },
				{ "slug": "2xl", "size": "6rem", "name": "2XL" },
				{ "slug": "3xl", "size": "8rem", "name": "3XL" }
			]
		},
		"typography": {
			"fluid": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Cormorant Garamond\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif",
					"name": "Cormorant Garamond",
					"slug": "heading",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin.woff2"]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "400 700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-italic-latin.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"Source Sans 3\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"name": "Source Sans 3 Body",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontWeight": "400 600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-sans-3-latin.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Small", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
				{ "slug": "medium", "size": "1.125rem", "name": "Medium", "fluid": { "min": "1.0625rem", "max": "1.125rem" } },
				{ "slug": "large", "size": "1.375rem", "name": "Large", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large", "size": "1.75rem", "name": "XL", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "size": "2.5rem", "name": "2XL", "fluid": { "min": "2rem", "max": "2.5rem" } },
				{ "slug": "xxx-large", "size": "3.5rem", "name": "3XL", "fluid": { "min": "2.5rem", "max": "3.5rem" } },
				{ "slug": "hero", "size": "4.5rem", "name": "Hero", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
			]
		},
		"custom": {
			"shadow": {
				"soft": "0 8px 32px rgba(44, 42, 40, 0.08)",
				"medium": "0 16px 48px rgba(44, 42, 40, 0.12)",
				"lift": "0 4px 16px rgba(166, 124, 82, 0.18)"
			},
			"radius": {
				"sm": "4px",
				"md": "12px",
				"lg": "24px",
				"arch": "50% 50% 0 0 / 20% 20% 0 0"
			},
			"line": {
				"gold": "1px solid rgba(166, 124, 82, 0.35)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--charcoal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2.5rem)",
				"right": "clamp(1.25rem, 4vw, 2.5rem)"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--gold-deep)" },
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": { "text": "var(--wp--preset--color--bronze)" },
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--gold)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "0.01em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600"
				}
			},
			"button": {
				"border": {
					"radius": "4px",
					"width": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--gold)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase",
					"lineHeight": "1.4"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"bottom": "0.95rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--gold-deep)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--bronze)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "italic"
				},
				"color": { "text": "var(--wp--preset--color--stone)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "500",
					"letterSpacing": "0.04em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--sand)" },
				"border": { "color": "var(--wp--preset--color--sand)" }
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--gold)",
					"width": "0 0 0 2px",
					"style": "solid"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-about", "title": "About Maison Calista", "postTypes": ["page"] },
		{ "name": "page-residence", "title": "The Residence", "postTypes": ["page"] },
		{ "name": "page-care", "title": "Care & Support", "postTypes": ["page"] },
		{ "name": "page-family", "title": "Family", "postTypes": ["page"] },
		{ "name": "page-activities", "title": "Activities", "postTypes": ["page"] },
		{ "name": "page-restaurant", "title": "Restaurant", "postTypes": ["page"] },
		{ "name": "page-pricing", "title": "Stays & Pricing", "postTypes": ["page"] },
		{ "name": "page-gallery", "title": "Gallery", "postTypes": ["page"] },
		{ "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
	]
}
